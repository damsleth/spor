// spor-tap: pass-through route Worker that counts requests to hosts that aren't Workers
// (a home server or VPS behind the Cloudflare proxy, Pages, another host). Copy to
// tap/wrangler.jsonc in your instance and list one route per host, or one wildcard pair per zone
// ("*.example.com/*" and "example.com/*") to count every proxied host, new ones included.
// A route only fires for orange-clouded (proxied) DNS records. It also runs in front of a Worker's
// custom domain, so a wildcard counts Worker sites too: list the ones that write their own point
// (snippets/) in SELF_COUNTED, or they are counted twice.
{
  "name": "spor-tap",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "app.example.com/*", "zone_name": "example.com" }
  ],
  // RECORD_IP: true stores client IPs (and makes the visitor hash unsalted). Without it, bind a
  // KV namespace as SALTS for daily unique visitors with an expiring salt:
  // "kv_namespaces": [{ "binding": "SALTS", "id": "<npx wrangler kv namespace create spor-salts>" }]
  "vars": { "SELF_COUNTED": [], "RECORD_IP": false },
  "analytics_engine_datasets": [{ "binding": "SPOR_ANALYTICS", "dataset": "spor_analytics" }]
}
